{
  "name": "dice-jar",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24"
  },
  "scripts": {
    "prepare": "husky",
    "dj": "npm run dev -w apps/dice-jar -- --open",
    "dg": "npm run dev -w apps/delta-green -- --open",
    "st": "npm run dev -w apps/stonetop -- --open",
    "bf": "npm run dev -w apps/bfrpg -- --open",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "build": "node scripts/workspaces.js build",
    "test": "node scripts/workspaces.js test",
    "typecheck": "node scripts/workspaces.js typecheck",
    "test:coverage": "node scripts/workspaces.js test:coverage",
    "test:rules": "node scripts/workspaces.js test:rules",
    "test:e2e": "node scripts/workspaces.js test:e2e",
    "test:scripts": "node --test scripts/*.test.js",
    "check": "prettier --check . && npm run lint && npm run knip && npm run test:scripts && npm run typecheck && npm run test:coverage"
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown",
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": "eslint --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "knip": "6.45.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.4"
  }
}
