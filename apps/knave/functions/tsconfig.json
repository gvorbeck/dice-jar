{
  // Typecheck only: esbuild bundles (see package.json build). Everything else comes from the repo's base config.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // DOM only because shared src/model code mentions localStorage and File; Functions never call those parts.
    "lib": ["ES2022", "DOM"],
    // The shared src code imports itself with the app's @/ alias.
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["src"]
}
