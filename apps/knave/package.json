{
  "name": "knave",
  "private": true,
  "license": "SEE LICENSE IN NOTICE",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm --prefix functions run build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && npm --prefix functions run typecheck",
    "knip": "knip",
    "test:rules": "firebase emulators:exec --only firestore --project demo-knave 'vitest run --config vitest.rules.config.ts'",
    "test:e2e": "firebase emulators:exec --only firestore --project demo-knave 'playwright test'",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run test:coverage"
  },
  "dependencies": {
    "@fontsource/alegreya-sc": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/unifrakturcook": "^5.3.0",
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dice-jar/browser": "*",
    "@dice-jar/cn": "*",
    "@dice-jar/dice": "*",
    "@dice-jar/diff": "*",
    "@dice-jar/e2e-helpers": "*",
    "@dice-jar/firebase": "*",
    "@dice-jar/game-id": "*",
    "@dice-jar/stale-build": "*",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "firebase-tools": "^15.35.0",
    "jsdom": "^31.0.0",
    "vite": "^8.3.6"
  }
}
