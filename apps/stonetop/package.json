{
  "name": "stonetop",
  "private": true,
  "license": "SEE LICENSE IN NOTICE",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "knip": "knip",
    "test:rules": "firebase emulators:exec --only firestore --project demo-stonetop 'vitest run --config vitest.rules.config.ts'",
    "test:e2e": "firebase emulators:exec --only firestore --project demo-stonetop 'playwright test'",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run test:coverage",
    "audit-backup": "node scripts/audit-backup.ts",
    "migration-status": "GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/migration-status.ts",
    "migrate-games": "GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/migrate-games.ts",
    "unmigrate-game": "GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/unmigrate-game.ts",
    "rehearse-migration": "firebase emulators:exec --only firestore --project demo-stonetop 'node scripts/rehearse-migration.ts'",
    "backup": "GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/backup.ts",
    "restore": "GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/restore.ts",
    "delete-game": "GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/delete-game.ts",
    "inspect-game": "GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/inspect-game.ts",
    "duplicate-game": "GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node scripts/duplicate-game.ts"
  },
  "dependencies": {
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.5.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@dice-jar/browser": "*",
    "@dice-jar/cn": "*",
    "@dice-jar/e2e-helpers": "*",
    "@dice-jar/firebase": "*",
    "@dice-jar/game-id": "*",
    "@dice-jar/stale-build": "*",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.35.0",
    "jsdom": "^31.0.0",
    "knip": "6.45.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.4"
  }
}
