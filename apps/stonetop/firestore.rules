rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // No auth: games are gated by a hard-to-guess shared ID in the URL.
    // Anyone with the ID can read/write that game — but only ONE game at a
    // time. The wildcard `read, write: if true` we had before also granted
    // `list` (enumerate every game ID in one query) and `delete` (wipe any
    // campaign), which defeats the by-ID model. Scope to /games, deny list
    // and delete, and validate the write shape.

    // A write must leave the doc looking like a game: core fields well-typed.
    function isValidGame(data) {
      return data.name is string
        && data.createdAt is number
        && data.characters is list;
    }

    // Every game is schemaVersion 2: characters and rolls live in the characters/ and rolls/ subcollections (see
    // MIGRATION.md), and the document keeps an empty characters list and no diceRolls. A browser can neither create
    // nor write a game in any other shape, so a tab still running an old build gets an error instead of saving
    // into arrays that nothing reads any more.
    function isValidV2(data) {
      return data.get('schemaVersion', 1) == 2 && data.characters.size() == 0 && !('diceRolls' in data);
    }

    // The fields the app writes. A write cannot add or change any other top-level key, so new fields need a release that allows them first.
    // An update only looks at the keys it changes, so a field a migration or restore preserved does not block saves.
    function knownFields() {
      return ['name', 'createdAt', 'characters', 'schemaVersion', 'content', 'threats', 'iWonder', 'steading', 'notes', 'notesLocks', 'restoreToken'];
    }

    match /games/{id} {
      allow get:    if true;
      allow list:   if false;
      allow create: if isValidGame(request.resource.data) && isValidV2(request.resource.data) && request.resource.data.keys().hasOnly(knownFields());
      allow update: if isValidGame(request.resource.data) && isValidV2(request.resource.data) && isValidV2(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(knownFields());
      allow delete: if false;

      function isV2Game() {
        let game = get(/databases/$(database)/documents/games/$(id));
        return game.data.get('schemaVersion', 1) == 2;
      }

      // shortcut: the party size is no longer capped here (a rule cannot count a subcollection); the app stops at 20.
      // Upgrade: keep a character count in the game document and check it in a transaction if abuse shows up.
      // Adding a field to a character or roll means adding it to its key list here first (a release before the app writes it).
      function characterKeys() {
        return ['id', 'name', 'playbook', 'level', 'data', 'order'];
      }

      // shortcut: a character or roll already stored that breaks these checks cannot be updated until it is fixed; every live one was checked
      // against them, and the app writes only what they allow (rulesAgree.test.ts). Upgrade: check only the changed fields on update.
      function isValidCharacter(data, cid) {
        return data.id == cid
          && data.name is string && data.name.size() <= 200
          && data.playbook is string && data.playbook.size() <= 50
          && data.level is number && data.level >= 0 && data.level <= 100
          && data.order is number
          && (!('data' in data) || (data.data is map && data.data.keys().size() <= 100));
      }

      function rollKeys() {
        return ['id', 'characterId', 'characterName', 'moveName', 'stat', 'resource', 'dice', 'dropped', 'mod', 'total', 'mode', 'burned',
                'band', 'notation', 'breakdown', 'createdAt', 'order'];
      }

      // A string that may be missing or null (band is null on some rolls) but is bounded when there.
      function shortOrAbsent(data, key, max) {
        return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= max);
      }

      function numberOrAbsent(data, key) {
        return !(key in data) || data[key] == null || data[key] is number;
      }

      // Rolls are edited in place (changing advantage or disadvantage on a roll keeps its id) and the oldest are deleted to keep the log short.
      function isValidRoll(data, rid) {
        return data.id == rid
          && data.characterId is string && data.characterId.size() <= 100
          && data.createdAt is number && data.order is number
          && shortOrAbsent(data, 'characterName', 200) && shortOrAbsent(data, 'moveName', 200) && shortOrAbsent(data, 'stat', 50)
          && shortOrAbsent(data, 'resource', 200) && shortOrAbsent(data, 'band', 50)
          && shortOrAbsent(data, 'notation', 2000) && shortOrAbsent(data, 'breakdown', 10000)
          && numberOrAbsent(data, 'mod') && numberOrAbsent(data, 'total') && numberOrAbsent(data, 'dropped')
          && (!('mode' in data) || data.mode in ['normal', 'adv', 'dis'])
          && (!('burned' in data) || data.burned is bool)
          && (!('dice' in data) || (data.dice is list && data.dice.size() <= 50));
      }

      match /characters/{cid} {
        allow get, list: if true;
        allow create: if isV2Game() && isValidCharacter(request.resource.data, cid) && request.resource.data.keys().hasOnly(characterKeys());
        allow update: if isV2Game() && isValidCharacter(request.resource.data, cid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(characterKeys());
        allow delete: if isV2Game();
      }

      match /rolls/{rid} {
        allow get, list: if true;
        allow create: if isV2Game() && isValidRoll(request.resource.data, rid) && request.resource.data.keys().hasOnly(rollKeys());
        allow update: if isV2Game() && isValidRoll(request.resource.data, rid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(rollKeys());
        allow delete: if isV2Game();
      }
    }

    // Everything outside /games is denied by default (no matching rule).
  }
}
