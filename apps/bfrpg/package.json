{
  "name": "bfrpg",
  "description": "Codex.Quest: Basic Fantasy RPG character generator and game manager",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_MOCK_FIREBASE=true vite",
    "dev:firebase": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "knip": "knip",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run test:coverage"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/react-query": "^5.89.0",
    "@tanstack/react-query-devtools": "^5.89.0",
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.12",
    "wouter": "^3.7.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@dice-jar/browser": "*",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "knip": "6.45.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.4"
  }
}
