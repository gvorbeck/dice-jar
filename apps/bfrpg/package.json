{
  "name": "bfrpg",
  "description": "Codex.Quest: Basic Fantasy RPG character generator and game manager",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulated": "vite --mode emulator",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-bfrpg",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "knip": "knip",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-bfrpg 'playwright test'",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run test:coverage"
  },
  "dependencies": {
    "@dice-jar/firebase": "*",
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@dice-jar/browser": "*",
    "@dice-jar/cn": "*",
    "@dice-jar/dice": "*",
    "@dice-jar/diff": "*",
    "@dice-jar/stale-build": "*",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "firebase-tools": "^15.35.0",
    "jsdom": "^31.0.0",
    "knip": "6.45.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.4"
  }
}
